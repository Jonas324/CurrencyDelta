@page "/currencydelta"
@rendermode InteractiveServer

<PageTitle>Currency Delta</PageTitle>

<div class="calculator-container">
    <h1>Currency Delta Calculator</h1>
    <p class="subtitle">Select a baseline currency, comparison currencies, and a date range to calculate exchange rate deltas.</p>

    <div class="form-card">
        <div class="form-row">
            <div class="form-group">
                <label>Baseline currency</label>
                <select @bind="baseline">
                    <option value="USD">USD</option>
                    <option value="EUR">EUR</option>
                    <option value="GBP">GBP</option>
                    <option value="SEK">SEK</option>                    
                    <option value="BANAN">BANAN</option>
                </select>
            </div>

            <div class="form-group">
                <label>Compare against</label>
                <select @bind="compareCurrency">
                    <option value="USD">USD</option>
                    <option value="EUR">EUR</option>
                    <option value="GBP">GBP</option>
                    <option value="SEK">SEK</option>
                    <option value="BANAN">BANAN</option>
                </select>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>From date</label>
                <input type="date" @bind="fromDate" />
            </div>

            <div class="form-group">
                <label>To date</label>
                <input type="date" @bind="toDate" />
            </div>
        </div>

        <button class="btn-calculate" @onclick="Calculate">Calculate</button>

        @if (errorMessage is not null)
        {
            <p class="error-message">@errorMessage</p>
        }

        @if (results is not null)
        {
            <table class="results-table">
                <thead>
                    <tr><th>Currency</th><th>Delta</th></tr>
                </thead>
                <tbody>
                    @foreach (var r in results)
                    {
                        <tr>
                            <td>@r.Currency</td>
                            <td>@r.Delta</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

